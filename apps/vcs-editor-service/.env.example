# HTTP port
PORT=3000

# Media root: source media is read from here, output written here (unless a
# signed uploadUrl is supplied per request).
OUTPUT_DIR=./output

# Content-addressed render cache (identical jobs skip re-encoding).
# Defaults to $OUTPUT_DIR/.render-cache when unset.
# RENDER_CACHE_DIR=./output/.render-cache

# ffmpeg binary for the fast render lane.
FFMPEG_PATH=ffmpeg

# ---- docker compose deploy ----
# Bearer every caller must send; core's EDITOR_SERVICE_TOKEN holds the same value.
# Generate with: openssl rand -hex 32
EDITOR_SERVICE_TOKEN=
# Public host Traefik routes to this service.
EDITOR_HOST=renderer-svc.videogpt.dev
# Caps so renders cannot starve other services on a shared box.
EDITOR_CPUS=2
EDITOR_MEMORY=3g
